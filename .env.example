# Twilio (Console → Account Info for SID; Account → API keys & tokens → Create API key)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # your purchased Twilio number (E.164)

# Target — [vendor] test line. Do NOT change.
TARGET_NUMBER=+1XXXXXXXXXX

# OpenAI (needs Realtime API access)
OPENAI_API_KEY=sk-...

# Public URL of the local server (ngrok forwarding URL, no trailing slash)
# e.g. https://abc123.ngrok-free.app
PUBLIC_URL=

# Server
PORT=8080
